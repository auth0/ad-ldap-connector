<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
     xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension">

  <Product Id="*"
          UpgradeCode="$(var.UpgradeCode)"
          Language='1033' Codepage='1252' Version="$(var.ProductVersion)"
          Name="Auth0 AD LDAP Connector"
          Manufacturer='Auth0 INC'>

    <Package Id='*' Keywords='Installer' Description="Auth0 LDAP Connector"
          Comments='Auth0 is a registered trademark of Auth0 INC' Manufacturer='Auth0 INC'
          InstallerVersion='100' Languages='1033' Compressed='yes' SummaryCodepage='1252'
          InstallScope="perMachine"/>

    <Media Id='1' EmbedCab='yes' Cabinet="main.cab" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\LICENSE.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.SourceDir)\public\images\msi-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.SourceDir)\public\images\msi-welcome.bmp" />

    <Icon Id="icon.ico" SourceFile="$(var.SourceDir)\public\images\logo.ico"/>

    <PropertyRef Id="NETFRAMEWORK45" />

    <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />

    <Condition Message="This application requires .NET Framework 4.5. Please install the .NET Framework then run this installer again.">
        <![CDATA[Installed OR NETFRAMEWORK45]]>
    </Condition>

    <Condition Message="Silent install run improperly. Please run the installer normally or contact Auth0 support.">
        <![CDATA[Installed OR UILevel >= 3 OR SILENT_UPDATE <> ""]]>
    </Condition>

    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion Minimum="$(var.ProductVersion)"
                      IncludeMinimum="no"
                      OnlyDetect="yes"
                      Language="1033"
                      Property="NEWPRODUCTFOUND" />

      <UpgradeVersion Minimum="$(var.RTMProductVersion)"
                      IncludeMinimum="yes"
                      Maximum="$(var.ProductVersion)"
                      IncludeMaximum="no"
                      Language="1033"
                      Property="UPGRADEFOUND" />
    </Upgrade>

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFilesFolder' Name='PFiles'>
        <Directory Id='Auth0_Folder' Name='Auth0'>
          <Directory Id='INSTALLDIR' Name='AD LDAP Connector'>
              <Directory Id="ADMINFOLDER" Name="admin" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder"
                    Name="Auth0"/>
      </Directory>
    </Directory>

    <CustomAction Id="PreventDowngrading"
              Error="Newer version already installed." />

    <!-- These must run BEFORE RemoveExistingProducts (which is scheduled early, right after
         InstallInitialize) so the customer's custom profile mapper is backed up before the old
         install is wiped. That ordering requires them to be *immediate* actions — a deferred action
         cannot execute in the pre-RemoveExistingProducts window (doing so triggers MSI error 2613).
         The interactive user's SID that an impersonated mkdir stamps onto data\profileMapper is
         scrubbed later by Limit-FilePermissions.ps1, which rebuilds the DACL from scratch as SYSTEM. -->
    <CustomAction Id="SaveCustomProfileMapper"
          Directory="INSTALLDIR"
          Execute="immediate"
          Return="ignore"
          ExeCommand="cmd.exe /c if not exist &quot;[INSTALLDIR]data\profileMapper\custom.js&quot; (mkdir &quot;[INSTALLDIR]data\profileMapper&quot; 2&gt;nul &amp; copy /y &quot;[INSTALLDIR]lib\profileMapper.js&quot; &quot;[INSTALLDIR]data\profileMapper\custom.js&quot;)" />

    <CustomAction Id="DeleteOldProfileMapper"
          Directory="INSTALLDIR"
          Execute="immediate"
          Return="ignore"
          ExeCommand="cmd.exe /c del /f /q &quot;[INSTALLDIR]lib\profileMapper.js&quot;" />

    <CustomAction Id="LaunchBrowser"
          ExeCommand="explorer.exe &quot;http://localhost:8357/&quot;"
          Directory="INSTALLDIR"
          Return="asyncNoWait" >
    </CustomAction>

    <InstallExecuteSequence>
      <Custom Action="SetInstallConnectorServicesData"
              After="InstallInitialize">NOT Installed</Custom>
      <Custom Action="SetWriteAdminPasswordFileData"
              After="InstallFiles"><![CDATA[ADMIN_PASSWORD <> ""]]></Custom>
      <Custom Action="WriteAdminPasswordFile"
              After="SetWriteAdminPasswordFileData"><![CDATA[ADMIN_PASSWORD <> ""]]></Custom>
      <Custom Action="InstallConnectorServices"
              After="WriteAdminPasswordFile">NOT Installed</Custom>
      <Custom Action="LaunchBrowser"
              OnExit="success">NOT Installed</Custom>
      <Custom Action="PreventDowngrading"
          After="FindRelatedProducts">NEWPRODUCTFOUND</Custom>
      <Custom Action="SaveCustomProfileMapper"
              Before="RemoveExistingProducts">1</Custom>
      <Custom Action="DeleteOldProfileMapper"
              After="SaveCustomProfileMapper">1</Custom>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>

    <Feature Id='Complete' Level='1'>
      <ComponentGroupRef Id='MainComponentGroup' />
      <ComponentRef Id="ApplicationShortcut" />
      <Component Id="node_component" Guid="{07D39FFF-C0C2-4D3F-BC22-EC7AE4963FFF}" Directory="INSTALLDIR">
        <File Id="node" KeyPath="yes" Source="$(var.NodeBin)" />
      </Component>
      <Component Id="nssm_component" Guid="{07D39AAA-CBB2-4F3F-BC22-EC7AE4963FFF}" Directory="INSTALLDIR">
        <File Id="nssm" KeyPath="yes" Source="$(var.NssmBin)" />
        <ServiceControl Id="ControlAdminService"
                 Name="Auth0 ADLDAP Admin"
                 Remove="uninstall"
                 Start="install"
                 Stop="both" />

        <ServiceControl Id="ControlConnectorService"
                 Name="Auth0 ADLDAP"
                 Remove="uninstall"
                 Stop="uninstall" />
      </Component>

    </Feature>

    <Property Id="WIXUI_TICKETURL" Secure="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <Property Id="ADMIN_PASSWORD" Hidden="yes" Secure="yes" />
    <Property Id="ADMIN_PASSWORD_CONFIRM" Hidden="yes" Secure="yes" />
    <Property Id="ADMIN_PASSWORD_ERROR" Hidden="yes" Secure="yes" />

    <!-- WriteAdminPasswordFile holds a command line with the admin password interpolated into it.
         HideTarget on the deferred CA hides its CustomActionData, but the immediate
         SetWriteAdminPasswordFileData SetProperty action would otherwise log the value in cleartext
         under verbose logging (msiexec /l*v). Declaring the property Hidden="yes" makes WiX add it to
         MsiHiddenProperties (that special property cannot be authored directly), suppressing the log. -->
    <Property Id="WriteAdminPasswordFile" Hidden="yes" />
    <Property Id="SILENT_UPDATE" Hidden="yes" Secure="yes" />

    <CustomAction Id="ValidateAdminPassword" Script="jscript" Return="ignore"><![CDATA[
      try {
        var password = Session.Property("ADMIN_PASSWORD");
        var confirm  = Session.Property("ADMIN_PASSWORD_CONFIRM");
        var result = "";
        if (!password) {
          result = "Password is required.";
        } else if (password.length < 15) {
          result = "Password must be at least 15 characters long.";
        } else if (password !== confirm) {
          result = "Passwords do not match.";
        }
        Session.Property("ADMIN_PASSWORD_ERROR") = result;
      } catch (e) {
        Session.Property("ADMIN_PASSWORD_ERROR") = "Validation error: " + (e.description || e.message || String(e));
      }
    ]]></CustomAction>

    <!-- Wrapped in powershell.exe (the same launch pattern InstallConnectorServices uses and which
         is proven to run here) so that ALL output — including a node launch failure that happens
         before setAdminPassword.js can write its own log — is redirected via *> to a file for
         diagnosis. All [..] tokens resolve in this immediate SetProperty action, so the deferred CA
         receives a fully literal command line. -->
    <CustomAction Id="SetWriteAdminPasswordFileData"
      Property="WriteAdminPasswordFile"
      Value="&quot;powershell.exe&quot; -NonInteractive -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; '[#node]' '[ADMINFOLDER]setAdminPassword.js' '[ADMIN_PASSWORD]' *&gt; '[INSTALLDIR]write-admin-password-ca.log'&quot;"
      Execute="immediate"
    />

    <CustomAction Id="WriteAdminPasswordFile"
      Directory="ADMINFOLDER"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      ExeCommand="[WriteAdminPasswordFile]"
      HideTarget="yes"
    />

    <UIRef Id="WixUI" />

  </Product>
</Wix>
